CONFIG_CLOCK_PIN_DATA=23
CONFIG_CLOCK_PIN_CLOCK=18
CONFIG_CLOCK_PIN_LATCH=19
CONFIG_CLOCK_PIN_OE=21
CONFIG_CLOCK_PIN_A=22
CONFIG_CLOCK_PIN_B=25
CONFIG_CLOCK_PIN_BUZZER=26
