{
  "name": "momentra-clock-ionic",
  "private": true,
  "version": "1.0.0",
  "description": "Ionic React companion app and simulator for the ESP32 P10 Momentra Clock",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:firmware-js": "node ../tests/test_dashboard.mjs && node ../tests/test_installer.mjs && node ../tests/test_installer_ota.mjs"
  },
  "dependencies": {
    "@ionic/react": "^8.8.21",
    "@ionic/react-router": "^8.8.21",
    "esptool-js": "^0.7.1",
    "ionicons": "^8.1.1",
    "js-md5": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.4.6"
  }
}
